---
import { Image } from 'astro:assets';
import mobileBg from '../assets/img/mobile-holding-page-background.jpg';
import desktopBg from '../assets/img/desktop-holding-page-background.jpg';
import squircle from '../assets/brand/dualpixel-outlined.svg';
import signature from '../assets/brand/signature-image.png';
---

<section class="relative flex min-h-screen items-center justify-center overflow-hidden px-6 py-16">
  <!-- Background: art-directed by breakpoint -->
  <Image
    src={mobileBg}
    alt=""
    class="absolute inset-0 -z-10 h-full w-full object-cover md:hidden"
    loading="eager"
    fetchpriority="high"
  />
  <Image
    src={desktopBg}
    alt=""
    class="absolute inset-0 -z-10 hidden h-full w-full object-cover md:block"
    loading="eager"
    fetchpriority="high"
  />

  <div class="flex w-full max-w-[354px] flex-col items-center gap-[10px] md:max-w-[622px] md:gap-[var(--gap-10)]">

    <!-- dualpixel outlined, superimposed over the area of ​​the portrait already composed in the background -->
    <img
      src={squircle.src}
      alt=""
      class="pointer-events-none absolute top-16 h-[354px] w-[354px] opacity-80 md:top-20 md:h-[668px] md:w-[668px]"
    />

    <!-- Text block -->
    <div class="relative z-10 flex flex-col items-center gap-[var(--gap-6)] text-center">

      <!-- Eyebrow -->
      <div class="flex flex-col items-center gap-[var(--gap-2)]">
        <span class="flex items-center gap-[var(--gap-2)] text-l-xs font-semibold uppercase tracking-loose text-[color:var(--onyx-600)]">
          <span class="h-1.5 w-1.5 rounded-full bg-icon-social-hover"></span>
          Available for work
        </span>
        <span class="text-l-xs font-semibold uppercase tracking-loose text-text-muted">
          Senior Product Designer
        </span>
      </div>

      <!-- Headline -->
      <h1
        class="font-display text-[48px] font-semibold leading-[56px] tracking-wide md:text-[80px]"
        style="background-image: var(--hero-name-gradient); background-clip: text; -webkit-background-clip: text; color: transparent;"
      >
        JD Albarran
      </h1>

      <!-- Subheadline -->
      <p class="font-display text-t-xl leading-[28px] md:text-[40px] md:leading-[52px]">
        <span class="font-extrabold tracking-widest text-[color:var(--core-400)]">Systems</span>
        <span class="font-semibold tracking-wider text-text-muted"> before </span>
        <span class="font-bold tracking-wider text-text-secondary">screens</span>
      </p>

      <!-- Badges -->
      <div class="flex flex-wrap items-center justify-center gap-[var(--gap-6)] border-t border-b border-[color:var(--onyx-800)] py-[var(--gap-10)]">
        <span class="rounded-full border border-[color:var(--onyx-800)] bg-surface-elevated px-[var(--gap-10)] py-[var(--gap-2)] text-l-sm font-semibold text-text-secondary">
          Design Systems
        </span>
        <span class="rounded-full border border-[color:var(--onyx-800)] bg-surface-elevated px-[var(--gap-10)] py-[var(--gap-2)] text-l-sm font-semibold text-text-secondary">
          Design Engineering
        </span>
        <span class="rounded-full border border-[color:var(--onyx-800)] bg-surface-elevated px-[var(--gap-10)] py-[var(--gap-2)] text-l-sm font-semibold text-text-secondary">
          Fintech
        </span>
      </div>

      <!-- Firma -->
      <Image src={signature} alt="JD Albarran signature" class="h-auto w-[114px] opacity-80" />

      <!-- Social icons -->
      <div class="flex items-center gap-[var(--gap-10)]">
        
          href="https://www.linkedin.com/in/jdalbpd/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn"
          class="flex h-12 w-12 items-center justify-center rounded-full border border-[color:var(--onyx-800)] text-icon-social transition-colors hover:text-icon-social-hover"
        >
          <svg width="28" height="28" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M24 10C16.2679 10 10 16.2679 10 24C10 31.7321 16.2679 38 24 38C31.7321 38 38 31.7321 38 24C38 16.2679 31.7321 10 24 10ZM20.5729 29.8027H17.7379V20.6794H20.5729V29.8027ZM19.1379 19.5594C18.2425 19.5594 17.6635 18.925 17.6635 18.1404C17.6635 17.3398 18.26 16.7244 19.1744 16.7244C20.0887 16.7244 20.6487 17.3398 20.6662 18.1404C20.6662 18.925 20.0887 19.5594 19.1379 19.5594ZM30.9271 29.8027H28.0921V24.7467C28.0921 23.5698 27.6808 22.7706 26.6556 22.7706C25.8725 22.7706 25.4073 23.3117 25.2017 23.8323C25.1258 24.0175 25.1069 24.28 25.1069 24.541V29.8012H22.2704V23.5888C22.2704 22.4498 22.234 21.4975 22.196 20.6779H24.6592L24.789 21.9452H24.8458C25.2192 21.3502 26.1335 20.4723 27.6633 20.4723C29.5285 20.4723 30.9271 21.7221 30.9271 24.4083V29.8027Z" fill="currentColor"/>
